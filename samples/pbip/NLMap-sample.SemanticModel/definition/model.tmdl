model Model
	culture: nl-NL
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: nl-NL
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Kaarten","Gemeenten","Provincies","Punten","GGD","Locaties"]

ref table Kaarten
ref table Gemeenten
ref table Provincies
ref table Punten
ref table GGD
ref table Locaties
