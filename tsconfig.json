{
    "compilerOptions": {
        "strict": false,
        "allowJs": false,
        "resolveJsonModule": true,
        "emitDecoratorMetadata": true,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "target": "es2022",
        "sourceMap": true,
        "outDir": "./.tmp/build/",
        "moduleResolution": "node",
        "declaration": true,
        "lib": [
            "es2022",
            "dom"
        ],
        "typeRoots": ["node_modules/@types"],
        "types": []
    },
    "files": [
        "./src/visual.ts",
        "./src/settings.ts"
    ],
    "exclude": ["**/_*", "**/._*"]
}